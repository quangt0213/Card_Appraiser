# Pi-specific overrides. Copy the app's full .env.example to .env first, then
# apply these production-leaning values on top. (These keys are read by config.py.)

# --- Server ---
HOST=0.0.0.0
PORT=5000
DEBUG=false
SCAN_WORKERS=1                 # keep 1 on a Pi 4
BLOCKING_SCAN_RESPONSE=true    # ESP32 waits for the final JSON
MAX_UPLOAD_BYTES=12000000      # reject oversized uploads

# --- Card data + pricing (free, keyless default) ---
CARD_DATA_PROVIDER=tcgcsv      # free daily TCGplayer catalog+market mirror
PRICE_SOURCE=sales             # real recent sales, with automatic market fallback
PRICE_STRATEGY=median          # reduce the last N sales
PRICE_RECENT_SALES_WINDOW=3
PRICE_FALLBACK_TO_MARKET=true
PRICE_REFRESH_MIN_HOURS=24
TCGCSV_REFRESH_HOURS=24
ENABLED_GAMES=pokemon,onepiece

# Optional paid recent-sales API instead of the free path:
# CARD_DATA_PROVIDER=tcgapis
# TCGAPIS_API_KEY=your_key_here

# --- OCR (accuracy-first, per project decision) ---
OCR_ENABLED=true
OCR_GPU=false                  # Pi has no CUDA GPU

# --- Matching thresholds ---
LOCAL_MATCH_THRESHOLD=0.72
REMOTE_MATCH_THRESHOLD=0.60
PHASH_MAX_DISTANCE=10
ORB_SHORTLIST=5

# --- SD-card kindness ---
# Point transient candidate downloads at RAM if you like (cleared on reboot):
# CANDIDATE_TEMP_DIR=/dev/shm/card-scanner-candidates
